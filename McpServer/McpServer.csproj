<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>McpServer</RootNamespace>
    <AssemblyName>McpServer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The Python scripts are part of the deployable output. -->
  <ItemGroup>
    <Content Include="Scripts\**\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    Machine-local settings written by the settings page (AppSettingsWriter writes to
    AppContext.BaseDirectory at runtime). Never built, published, or committed — see
    .gitignore. Excluding it here also stops a stale copy in the source tree from being
    picked up by the SDK's default appsettings*.json glob.
  -->
  <ItemGroup>
    <Content Remove="appsettings.production.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

</Project>
