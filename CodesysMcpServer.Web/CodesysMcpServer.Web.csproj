<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>CodesysMcpServer.Web</RootNamespace>
		<AssemblyName>CodesysMcpServer.Web</AssemblyName>
		<InvariantGlobalization>true</InvariantGlobalization>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
	</PropertyGroup>

	<!-- The Python scripts are part of the deployable output. -->
	<ItemGroup>
		<Content Include="Scripts\**\*.py">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="appsettings.Development.json" />
		<Content Remove="appsettings.production.json" />
	</ItemGroup>

	<ItemGroup>
		<None Include="appsettings.Development.json" />
		<None Include="appsettings.production.json" />
	</ItemGroup>

</Project>
